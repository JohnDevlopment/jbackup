_jbackup_completion() {
    local IFS=$'
'
    COMPREPLY=( $( env COMP_WORDS="${COMP_WORDS[*]}" \
                   COMP_CWORD=$COMP_CWORD \
                   _JBACKUP_COMPLETE=complete_bash $1 ) )
    return 0
}

complete -o default -F _jbackup_completion jbackup

echo "Completion setup for jbackup"
